PORT=8080

# Comma-separated origins allowed to open the signalling WebSocket, e.g. https://chat.example.com
# Leave empty to allow any origin.
ALLOWED_ORIGINS=

# MaxMind account ID + license key, used by the geoipupdate sidecar to keep
# ./geoip/GeoLite2-City.mmdb current. Get these from https://www.maxmind.com/en/accounts/current/license-key
MAXMIND_ACCOUNT_ID=
MAXMIND_LICENSE_KEY=
