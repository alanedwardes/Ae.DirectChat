{
    "compilerOptions": {
        "strict": false,
        "noImplicitAny": true,
        "noImplicitReturns": true,
        "noImplicitThis": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "alwaysStrict": true,
        "rootDir": "./ts/",
        "outDir": "./wwwroot/js/",
        "module": "ES2020",
        "moduleResolution": "Bundler",
        "target": "ES2020",
        "lib": [
            "ES2020",
            "DOM"
        ]
    },
    "include": [
        "ts/**/*"
    ]
}
